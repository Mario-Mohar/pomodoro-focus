{
  "name": "pomodoro-focus",
  "version": "1.0.0",
  "description": "Pomodoro-Timer mit Aufgabenliste und Statistik - laeuft vollstaendig im Browser",
  "license": "MIT",
  "author": "Mario Mohar",
  "keywords": [
    "pomodoro",
    "timer",
    "todo",
    "pwa",
    "productivity",
    "offline-first"
  ],
  "scripts": {
    "start": "npx --yes serve public -l 3000",
    "build:css": "npx tailwindcss -i ./public/input.css -o ./public/output.css --minify",
    "watch:css": "npx tailwindcss -i ./public/input.css -o ./public/output.css --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "tailwindcss": "^3.4.18",
    "vitest": "^4.1.11"
  }
}
